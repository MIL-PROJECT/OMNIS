{
  "name": "omnis-desktop",
  "version": "1.1.0",
  "description": "OMNIS (Operations & Maintenance Network Integrated System) offline demo desktop application",
  "author": "OMNIS Demo Team",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <25",
    "pnpm": ">=11 <13"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm db:build-seed && electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:e2e:roles": "node tests/e2e/roles.mjs",
    "test:e2e:signup": "node tests/e2e/signup.mjs",
    "test:e2e:operations": "node tests/e2e/operations-flow.mjs",
    "test:e2e:visual": "node tests/e2e/visual-check.mjs",
    "test:e2e:external-ai": "node tests/e2e/external-ai.mjs",
    "test:e2e:ai-settings": "node tests/e2e/ai-settings-flow.mjs",
    "test:external-ai:live": "tsx scripts/external-ai-smoke.ts",
    "icons:mac": "node scripts/generate-mac-icon.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:seed": "tsx scripts/build-seed-db.ts",
    "db:build-seed": "tsx scripts/build-seed-db.ts",
    "rebuild:native": "electron-builder install-app-deps",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "dist:mac": "pnpm build && electron-builder --mac dmg zip",
    "dist:mac:x64": "pnpm build && electron-builder --mac dmg zip --x64",
    "dist:mac:arm64": "pnpm build && electron-builder --mac dmg zip --arm64",
    "postinstall": "electron-builder install-app-deps",
    "test:e2e:usability": "node tests/e2e/usability.mjs",
    "test:e2e:organizations": "node tests/e2e/organizations.mjs",
    "test:e2e:duty-units": "node tests/e2e/duty-units.mjs",
    "test:e2e:manuals": "node tests/e2e/manuals.mjs",
    "test:e2e:admin": "node tests/e2e/admin-users.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "electron-log": "5.4.4",
    "openai": "^7.45.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@hookform/resolvers": "5.9.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/x-data-grid": "9.13.0",
    "@tanstack/react-query": "5.103.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitejs/plugin-react": "5.1.1",
    "date-fns": "4.4.0",
    "drizzle-kit": "0.31.10",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.3",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "pretendard": "1.3.9",
    "prettier": "3.9.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "7.88.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "5.0.1",
    "zustand": "5.0.15"
  }
}

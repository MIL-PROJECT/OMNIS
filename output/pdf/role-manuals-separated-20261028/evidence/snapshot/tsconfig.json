{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "esModuleInterop": true, "allowSyntheticDefaultImports": true,
    "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true,
    "types": ["node", "vite/client"], "lib": ["ES2022", "DOM"]
  },
  "include": ["src", "scripts", "tests", "electron.vite.config.ts"]
}
